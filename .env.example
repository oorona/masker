# Copy to .env to override the defaults baked into pi/*/run.sh.
# (The defaults already match docker-compose.yml, so .env is optional.)

# Production data DB (sensitive) — used by the prod agent.
PROD_PG_URL=postgresql://masker:masker@localhost:5432/fintechP

# Test data DB (masked only) — used by the test agent.
TEST_PG_URL=postgresql://masker:masker@localhost:5432/fintechT

# Shared mailbox DB — used by BOTH agents.
BUS_URL=postgresql://masker:masker@localhost:5432/bus

# Pi model/provider come from each agent's pi/<agent>/.pi/settings.json
# (defaults to your global github-copilot / gpt-5.4).
